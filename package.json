{
  "name": "demon-scanner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "db:generate": "node --env-file-if-exists=.env --import tsx node_modules/drizzle-kit/bin.cjs generate",
    "test": "node --env-file-if-exists=.env --import tsx --test test/api.test.ts",
    "test:live": "RUN_LIVE=1 node --env-file-if-exists=.env --import tsx --test test/live.smoke.test.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
